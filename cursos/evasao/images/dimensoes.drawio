        <mxCell id="qBwtaj_6MSGP0vAOBpl8-1" value="&lt;font style=&quot;font-size: 20px; color: rgb(0, 0, 102);&quot;&gt;&lt;b style=&quot;&quot;&gt;Dimensões&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=#7ea6e0;" vertex="1" parent="1">
