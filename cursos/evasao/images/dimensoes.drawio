        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-2" value="&lt;font style=&quot;font-size: 20px; color: rgb(153, 0, 0);&quot;&gt;Saúde Mental&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="421" y="780" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-3" value="&lt;font style=&quot;font-size: 20px; color: rgb(0, 0, 102);&quot;&gt;Desempenho Acadêmico&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="431" y="660" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-4" value="&lt;font style=&quot;font-size: 20px; color: rgb(153, 0, 77);&quot;&gt;Motivos Financeiros&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" vertex="1" parent="1">
          <mxGeometry x="431" y="560" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-5" value="&lt;font style=&quot;font-size: 20px; color: rgb(102, 51, 0);&quot;&gt;Expectativas de Carreira&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcd28;gradientColor=#ffa500;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="431" y="420" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-6" value="&lt;font style=&quot;font-size: 20px; color: rgb(51, 102, 0);&quot;&gt;Adaptabilidade de Carreira&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="431" y="280" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-7" value="&lt;font style=&quot;font-size: 20px; color: rgb(204, 102, 0);&quot;&gt;Experiências Acadêmicas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="431" y="180" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-8" value="&lt;font style=&quot;font-size: 20px; color: rgb(153, 0, 0);&quot;&gt;Autoeficácia Acadêmica&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="431" y="80" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-17" value="&lt;div&gt;&lt;font style=&quot;color: rgb(153, 0, 0); font-size: 17px;&quot;&gt;Relaciona-se à confiança dos estudantes&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;em suas habilidades para realizar tarefas acadêmicas, impactando&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;diretamente sua persistência nos estudos. Nessa dimensão, o foco é a&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;autorregulação acadêmica.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;labelBackgroundColor=none;fontSize=14;strokeColor=#990000;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="751" y="70" width="609" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-18" value="&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;color: rgb(204, 102, 0);&quot;&gt;Incluem a satisfação com o curso,&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(204, 102, 0); background-color: transparent;&quot;&gt;relações interpessoais e a integração ao ambiente universitário.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;labelBackgroundColor=none;fontSize=14;strokeColor=#CC6600;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="751" y="170" width="609" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-19" value="&lt;font style=&quot;font-size: 17px;&quot; color=&quot;#336600&quot;&gt;Refere-se à capacidade dos estudantes de ajustarem-se às demandas do curso e às expectativas do mercado de trabalho. Essa dimensão baseia-se no conceito central da psicologia vocacional proposto por Mark L. Savickas dentro da Teoria da Construção de Carreira.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;labelBackgroundColor=none;fontSize=14;strokeColor=#336600;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="751" y="260" width="609" height="100" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-20" value="&lt;div&gt;&lt;font style=&quot;font-size: 17px; color: rgb(102, 51, 0);&quot;&gt;&lt;font&gt;As percepções dos alunos sobre suas perspectivas profissionais podem influenciar seu compromisso com o curso.&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Nessa dimensão, o foco concentra-se no retorno financeiro esperado, empregabilidade e alinhamento vocacional.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;labelBackgroundColor=none;fontSize=14;strokeColor=#D79B00;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="751" y="405" width="609" height="90" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-21" value="&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;color: rgb(153, 0, 77);&quot;&gt;A insuficiência de recursos financeiros é&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(153, 0, 77); background-color: transparent;&quot;&gt;uma causa recorrente de evasão, destacando a necessidade de políticas de assistência estudantil. Nessa dimensão, o foco é captar a privação&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(153, 0, 77); background-color: transparent;&quot;&gt;objetiva da dificuldade financeira.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;labelBackgroundColor=none;fontSize=14;strokeColor=#99004D;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="751" y="550" width="609" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-22" value="&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;font color=&quot;#000066&quot;&gt;Notas baixas ou reprovações frequentes&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 102); background-color: transparent;&quot;&gt;estão entre os fatores que frequentemente precedem o abandono do&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 102); background-color: transparent;&quot;&gt;curso. Nessa dimensão o foco é a percepção do desempenho acadêmico&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 102); background-color: transparent;&quot;&gt;na visão do discente.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;labelBackgroundColor=none;fontSize=14;strokeColor=#0000CC;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="751" y="650" width="609" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qBwtaj_6MSGP0vAOBpl8-23" value="&lt;div&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;Transtornos psicológicos e estresse&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 17px; color: rgb(153, 0, 0); background-color: transparent;&quot;&gt;acadêmico impactam diretamente a permanência e o desempenho dos&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 17px; color: rgb(153, 0, 0); background-color: transparent;&quot;&gt;alunos. Nessa dimensão, são considerados os seguintes eixos:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 17px; color: rgb(153, 0, 0); background-color: transparent;&quot;&gt;ansiedade, depressão, estresse acadêmico e exaustão (burnout),&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 17px; color: rgb(153, 0, 0); background-color: transparent;&quot;&gt;mantendo o foco funcional no impacto nos estudos e não no&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;diagnóstico clínico.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;labelBackgroundColor=none;fontSize=14;strokeColor=#990000;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="751" y="755" width="609" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
