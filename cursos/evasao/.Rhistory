# Dados CCE
ano <- c(2015:2024)
evasao <- c(48.0, 16.3, 19.7, 16.7, 35.9, 22.1, 31.4, 43.3, 43.4)
evadidos <- c(295, 99, 127, 112, 236, 145, 197, 258, 243)
matriculados <- c(614,  607,  646,  669,  658,  656,  628,  596,  560)
par(mar=c(5, 4, 4, 6) + 0.1)
# criar o primeiro eixo Y
plot(y=evadidos, x=ano, lty=1, axes=TRUE,
xlab="", ylab="", type="l",
col="black", main="Matriculados e evadidos por ano") # gráfico para a variável X
# Dados CCE
ano <- c(2015:2024)
evasao <- c(48.0, 16.3, 19.7, 16.7, 35.9, 22.1, 31.4, 43.3, 43.4)
evadidos <- c(295, 99, 127, 112, 236, 145, 197, 258, 243)
matriculados <- c(614,  607,  646,  669,  658,  656,  628,  596,  560)
par(mar=c(5, 4, 4, 6) + 0.1)
# criar o primeiro eixo Y
plot(y=evadidos, x=ano, lty=1, axes=TRUE,
xlab="", ylab="", type="l",
col="black", main="Matriculados e evadidos por ano") # gráfico para a variável X
ano <- c(2015:2024)
evasao <- c(48.0, 16.3, 19.7, 16.7, 35.9, 22.1, 31.4, 43.3, 43.4, 27.3)
evadidos <- c(295, 99, 127, 112, 236, 145, 197, 258, 243, 142)
matriculados <- c(614,  607,  646,  669,  658,  656,  628,  596,  560, 521)
par(mar=c(5, 4, 4, 6) + 0.1)
# criar o primeiro eixo Y
plot(y=evadidos, x=ano, lty=1, axes=TRUE,
xlab="", ylab="", type="l",
col="black", main="Matriculados e evadidos por ano") # gráfico para a variável X
#axis(2, ylim=c(2,60), col="black", las=1) # etiqueta horizontal
mtext("Evadidos", side=2, line=2.5) # nomear o primeiro eixo Y
box() # criar uma caixa para o gráfico
# criar o segundo eixo Y
par(new=TRUE)
plot(matriculados, lty=2,  xlab="", ylab="",
axes=FALSE, type="l", col="steelblue")
mtext("Matriculados",side=4,col="steelblue",line=4)
axis(4, ylim=c(2,60), col="steelblue",col.axis="steelblue",las=1)
#axis(1, at = seq(10,22,1))
# adicionar uma legenda ao gráfico
legend("topleft",legend=c("Evadidos","Matriculados"),
text.col=c("black","steelblue"),lty=c(1,2),col=c("black","steelblue"))
library(ggplot2)
data2 = data.frame(Ano = ano, Evadidos = evadidos, Matriculados = matriculados)
ggplot(data2, aes(x = Ano, y = Matriculados)) +
geom_line(aes(color = "Matriculados")) +
geom_line(aes(y = Evadidos+400, color = "Evadidos"))+
scale_x_continuous(breaks = ano) +
scale_y_continuous(sec.axis = sec_axis(~ . -400 , name="Evadidos"))+
labs(x = "Ano", y = "Matriculados", color = " ") +
scale_color_manual(values = c("orange2", "darkblue")) +
theme_bw() + theme(legend.position = "bottom",
axis.title.x = element_blank(),
axis.title = element_text(size = 12),
axis.text = element_text(size = 12, colour = "black"),
legend.text = element_text(size = 12))
ggplot(data2, aes(x = Ano, y = Matriculados)) +
geom_line(aes(color = "Matriculados")) +
geom_line(aes(y = Evadidos+400, color = "Evadidos"))+
scale_x_continuous(breaks = ano) +
scale_y_continuous(sec.axis = sec_axis(~ . -400 , name="Evadidos"))+
labs(x = "Ano", y = "Matriculados", color = " ") +
scale_color_manual(values = c("orange2", "darkblue")) +
theme_bw() + theme(legend.position = "bottom",
axis.title.x = element_blank(),
axis.title = element_text(size = 12),
axis.text = element_text(size = 12, colour = "black"),
legend.text = element_text(size = 12))+
geom_vline(xintercept = 2019, linetype="dashed",
color = "red", size=1.5)
ggplot(data2, aes(x = Ano, y = Matriculados)) +
geom_line(aes(color = "Matriculados")) +
geom_line(aes(y = Evadidos+400, color = "Evadidos"))+
scale_x_continuous(breaks = ano) +
scale_y_continuous(sec.axis = sec_axis(~ . -400 , name="Evadidos"))+
labs(x = "Ano", y = "Matriculados", color = " ") +
scale_color_manual(values = c("orange2", "darkblue")) +
theme_bw() + theme(legend.position = "bottom",
axis.title.x = element_blank(),
axis.title = element_text(size = 12),
axis.text = element_text(size = 12, colour = "black"),
legend.text = element_text(size = 12))+
geom_vline(xintercept = 2019, linetype="dashed",
color = "red", size=1.)
